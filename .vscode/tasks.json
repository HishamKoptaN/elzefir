{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Prepare Android Local Env",
      "dependsOn": ["Start Laravel Server", "run-adb-reverse"],
      "dependsOrder": "parallel"
    },
    {
        "label": "Start Laravel Server",
        "type": "shell",
        "command": "if ! lsof -i :8000 > /dev/null; then cd ~/coding/backend/elzefir && php artisan serve --host=0.0.0.0 --port=8000; else echo 'سيرفر لارافيل يعمل بالفعل وجاهز لاستقبال الطلبات.'; fi",
        "isBackground": true,
        "runOptions": {
            "runOn": "folderOpen"
        },
        "presentation": {
            "reveal": "silent",
            "panel": "shared"
        },
        "problemMatcher": []
    },
    {
        "label": "run-adb-reverse",
        "type": "shell",
        "command": "adb reverse tcp:8000 tcp:8000",
        "presentation": {
            "reveal": "silent",
            "panel": "shared"
        }
    },
    {
      "label": "Flutter: Watch Models",
      "type": "shell",
      "command": "dart run build_runner watch --delete-conflicting-outputs",
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "silent" }
    }
  ]
}