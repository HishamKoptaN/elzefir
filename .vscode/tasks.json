{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Prepare Android Local Env",
      "dependsOn": [
        "run-adb-reverse"
      ],
      "dependsOrder": "parallel"
    },
    {
      "label": "run-adb-reverse",
      "type": "shell",
      "command": "adb reverse tcp:8000 tcp:8000",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "Flutter: Watch Models",
      "type": "shell",
      "command": "dart run build_runner watch --delete-conflicting-outputs",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent"
      }
    }
  ]
}